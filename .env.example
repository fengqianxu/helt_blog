# Image names can include a registry prefix, for example registry.example.com/team/helt-blog.
IMAGE_PREFIX=helt-blog
IMAGE_TAG=latest

# Use 0.0.0.0 only when the host firewall and TLS reverse proxy are configured.
BIND_ADDRESS=127.0.0.1
WEB_PORT=18080

# Replace every secret before a production deployment.
# POSTGRES_PASSWORD is embedded in a URL; use a long URL-safe value (letters,
# numbers, hyphens and underscores) rather than characters such as @, :, / or #.
POSTGRES_DB=helt_blog
POSTGRES_USER=helt
POSTGRES_PASSWORD=replace-with-a-strong-database-password

MINIO_ROOT_USER=helt_minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Used only with docker-compose.debug.yml. The normal startup publishes none of
# these internal services to the host.
BACKEND_DEBUG_PORT=18081
POSTGRES_DEBUG_PORT=15432
MINIO_API_DEBUG_PORT=19000
MINIO_CONSOLE_DEBUG_PORT=19001

APP_ENV=production
RUST_LOG=info,sqlx=warn,tower_http=info
LOG_FORMAT=pretty
CORS_ALLOWED_ORIGINS=http://localhost:18080
PUBLIC_ORIGIN=http://localhost:18080

ADMIN_USERNAME=helt
# Leave empty to generate a random initial password and print it once in backend logs.
ADMIN_INITIAL_PASSWORD=
# Generate a long random value (at least 32 characters) before production use.
AUTH_JWT_SECRET=replace-with-a-long-random-auth-secret

# Artalk comment-service signing key. When empty, the normal Compose file uses
# AUTH_JWT_SECRET as a stable fallback; use a separate random value in production.
ARTALK_APP_KEY=
# Dedicated Artalk administrator used by the backend to lock and delete pages.
# You can also use this account to sign in to the Artalk dashboard.
ARTALK_ADMIN_NAME=blog-service
ARTALK_ADMIN_EMAIL=artalk-service@localhost.invalid
ARTALK_ADMIN_PASSWORD=replace-with-a-strong-artalk-admin-password
# true keeps visitor comments hidden until approved in the Artalk dashboard.
ARTALK_PENDING_DEFAULT=true

# Independent key used only for saved LLM API credentials. It is mandatory and
# must not reuse AUTH_JWT_SECRET. Keep version 1 until performing a rotation.
LLM_ENCRYPTION_KEY=replace-with-an-independent-long-random-llm-secret
LLM_ENCRYPTION_KEY_VERSION=1
# During rotation, set both previous values, start the backend, then run:
# This command rotates both LLM and encrypted Steam Web API keys.
# docker compose exec backend blog-admin rotate-llm-encryption-key
LLM_ENCRYPTION_PREVIOUS_KEY=
LLM_ENCRYPTION_PREVIOUS_KEY_VERSION=
# Exact private LLM hostnames/IPs allowed to bypass public-IP and production
# HTTPS enforcement. Leave empty unless an intentional private endpoint exists.
LLM_PRIVATE_HOST_ALLOWLIST=
